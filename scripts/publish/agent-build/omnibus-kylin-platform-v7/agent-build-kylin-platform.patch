diff --git a/omnibus/lib/ostools.rb b/omnibus/lib/ostools.rb
--- a/omnibus/lib/ostools.rb
+++ b/omnibus/lib/ostools.rb
@@ -2,6 +2,9 @@
 # OS-detection helper functions
 # ------------------------------------
 def linux_target?()
+    if not Omnibus::Config.host_distribution().nil?
+      return %w(rhel debian fedora suse gentoo slackware arch exherbo).include? Omnibus::Config.host_distribution()
+    end
     return %w(rhel debian fedora suse gentoo slackware arch exherbo).include? ohai['platform_family']
 end
 
diff --git a/omnibus/config/software/datadog-agent.rb b/omnibus/config/software/datadog-agent.rb
--- a/omnibus/config/software/datadog-agent.rb
+++ b/omnibus/config/software/datadog-agent.rb
@@ -58,6 +58,18 @@ build do
   build_workers = ENV.fetch('OMNIBUS_WORKERS_OVERRIDE', '1')
   env['GOMAXPROCS'] = build_workers
   env['GOFLAGS'] = "-p=#{build_workers}"
+  go_tmpdir = ENV.fetch('GOTMPDIR')
+  tmpdir = ENV.fetch('TMPDIR')
+  unless go_tmpdir == tmpdir
+    raise "GOTMPDIR and TMPDIR must select the same pinned Go temporary directory"
+  end
+  unless Pathname.new(go_tmpdir).absolute? && Dir.exist?(go_tmpdir)
+    raise "pinned Go temporary directory must be an existing absolute directory"
+  end
+  # Mixlib command environments are explicit. Forward both variables so the
+  # nested dda/invoke process, the Go driver, and cgo helpers share this path.
+  env['GOTMPDIR'] = go_tmpdir
+  env['TMPDIR'] = tmpdir
   unless windows_target?
     env['LDFLAGS'] = "-Wl,-rpath,#{install_dir}/embedded/lib -L#{install_dir}/embedded/lib"
     env['CGO_CFLAGS'] = "-I. -I#{install_dir}/embedded/include"
@@ -192,8 +204,74 @@ build do
   # System-probe
   if sysprobe_enabled? || osx_target? || (windows_target? && do_windows_sysprobe != "")
     if linux_target?
       command "dda inv -- -e system-probe.build-sysprobe-binary #{fips_args} --install-path=#{install_dir}", env: env, :live_stream => Omnibus.logger.live_stream(:info)
-      command "!(objdump -p ./bin/system-probe/system-probe | egrep 'GLIBC_2\.(1[8-9]|[2-9][0-9])')"
+      command <<~'SH'
+        set -efu
+        export LC_ALL=C
+
+        binary=./bin/system-probe/system-probe
+        ceiling=2.28
+        if ! objdump_output=$(objdump -p "$binary"); then
+          echo "system-probe GLIBC audit could not inspect $binary with objdump" >&2
+          exit 1
+        fi
+        glibc_tokens=$(
+          printf '%s\n' "$objdump_output" |
+            grep -oE 'GLIBC_[^[:space:]]*' |
+            sort -u
+        )
+        if [ -z "$glibc_tokens" ]; then
+          echo "system-probe GLIBC audit found no GLIBC version tokens" >&2
+          exit 1
+        fi
+
+        for token in $glibc_tokens; do
+          version=${token#GLIBC_}
+          if awk -v version="$version" -v ceiling="$ceiling" '
+            BEGIN {
+              actual_count = split(version, actual, ".")
+              ceiling_count = split(ceiling, limit, ".")
+              if (actual_count < 2) {
+                exit 2
+              }
+              for (component_index = 1; component_index <= actual_count; component_index++) {
+                if (actual[component_index] !~ /^[0-9]+$/) {
+                  exit 2
+                }
+              }
+              count = actual_count > ceiling_count ? actual_count : ceiling_count
+              for (component_index = 1; component_index <= count; component_index++) {
+                actual_component = component_index <= actual_count ? actual[component_index] + 0 : 0
+                ceiling_component = component_index <= ceiling_count ? limit[component_index] + 0 : 0
+                if (actual_component < ceiling_component) {
+                  exit 0
+                }
+                if (actual_component > ceiling_component) {
+                  exit 3
+                }
+              }
+              exit 0
+            }
+          '; then
+            :
+          else
+            status=$?
+            case $status in
+              2)
+                echo "system-probe GLIBC audit rejected non-numeric token: $token" >&2
+                ;;
+              3)
+                echo "system-probe requires $token (maximum allowed is GLIBC_$ceiling)" >&2
+                ;;
+              *)
+                echo "system-probe GLIBC audit failed while checking token: $token" >&2
+                ;;
+            esac
+            exit 1
+          fi
+        done
+        printf 'system-probe GLIBC requirements satisfy maximum GLIBC_%s\n' "$ceiling"
+      SH
     else
       command "dda inv -- -e system-probe.build #{fips_args}", env: env, :live_stream => Omnibus.logger.live_stream(:info)
     end
