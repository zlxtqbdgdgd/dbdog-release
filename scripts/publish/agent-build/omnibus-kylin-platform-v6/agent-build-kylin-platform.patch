diff --git a/omnibus/lib/ostools.rb b/omnibus/lib/ostools.rb
--- a/omnibus/lib/ostools.rb
+++ b/omnibus/lib/ostools.rb
@@ -2,6 +2,9 @@
 # OS-detection helper functions
 # ------------------------------------
 def linux_target?()
+    if not Omnibus::Config.host_distribution().nil?
+      return %w(rhel debian fedora suse gentoo slackware arch exherbo).include? Omnibus::Config.host_distribution()
+    end
     return %w(rhel debian fedora suse gentoo slackware arch exherbo).include? ohai['platform_family']
 end
 
diff --git a/omnibus/config/software/datadog-agent.rb b/omnibus/config/software/datadog-agent.rb
--- a/omnibus/config/software/datadog-agent.rb
+++ b/omnibus/config/software/datadog-agent.rb
@@ -58,6 +58,18 @@ build do
   build_workers = ENV.fetch('OMNIBUS_WORKERS_OVERRIDE', '1')
   env['GOMAXPROCS'] = build_workers
   env['GOFLAGS'] = "-p=#{build_workers}"
+  go_tmpdir = ENV.fetch('GOTMPDIR')
+  tmpdir = ENV.fetch('TMPDIR')
+  unless go_tmpdir == tmpdir
+    raise "GOTMPDIR and TMPDIR must select the same pinned Go temporary directory"
+  end
+  unless Pathname.new(go_tmpdir).absolute? && Dir.exist?(go_tmpdir)
+    raise "pinned Go temporary directory must be an existing absolute directory"
+  end
+  # Mixlib command environments are explicit. Forward both variables so the
+  # nested dda/invoke process, the Go driver, and cgo helpers share this path.
+  env['GOTMPDIR'] = go_tmpdir
+  env['TMPDIR'] = tmpdir
   unless windows_target?
     env['LDFLAGS'] = "-Wl,-rpath,#{install_dir}/embedded/lib -L#{install_dir}/embedded/lib"
     env['CGO_CFLAGS'] = "-I. -I#{install_dir}/embedded/include"
