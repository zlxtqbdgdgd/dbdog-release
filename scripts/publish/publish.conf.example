# 发布配置（复制为 publish.conf 填写；publish.conf 已 gitignore）
#
# 构建执行器合同（只声明"用哪台原生机构建"，不保存任何凭证）：
# 每个受支持架构都必须有一台独立的原生 builder，严禁 QEMU / 交叉编译 / 把未登记的
# VM 顶替成 builder。没有为某架构配置原生 builder 时，该架构整体在任何构建/上传前失败。
BUILD_HOST_AARCH64="dbdog-build"     # 标准维护机，在 ~/.ssh/config 中定义
BUILD_HOST_X86_64="z1@CHANGE-ME"     # 独立的原生 x86_64 builder；未配置真实机器前留占位值

# Agent 构建以 root 建私有挂载命名空间（把构建安装根 bind 到 /opt/dbdog-agent 上，
# 构建期不停宿主 agent）。默认从 aarch64 builder 的 ssh 配置解析 root@<hostname>；
# root 通路另有别名/跳板时在这里显式指定。
#BUILD_HOST_ROOT="root@dbdog-build"

# 兼容回退：只在未设置 BUILD_HOST_<ARCH> 时才会退回这个旧的单一 BUILD_HOST——且仅当
# 发布前在它上面执行 `uname -m` 并经 normalize_arch 精确等于请求架构才会被接受；
# 不一致时该架构整体拒绝构建（不会静默换机器，也不会用 QEMU 模拟）。
BUILD_HOST="dbdog-build"

# 各源仓在本机的父目录（默认取 dbdog-release 的上一级，通常无需改）
#SRC_ROOT="$HOME/Code/github.com/zlxtqbdgdgd"

# 构建机上的目录
REPO_ROOT="/home/dbdog/repo"               # 各源仓在构建机上的 clone 父目录
BUILD_WORK="/home/dbdog/dbdog-release-build" # 发布构建工作目录（自动创建）

# 构建机上工具链 PATH 前缀（go / cargo / node 所在 bin 目录，冒号分隔）
TOOL_PATH="/home/dbdog/tools/go/bin:/home/dbdog/tools/node/bin:/home/dbdog/.cargo/bin"

# dbdog-agent 版本前缀和实际出货源码不接受本机配置覆盖。发布器只读取：
#   $SRC_ROOT/dbdog-agent/dbdog-deploy/RELEASE-BASELINE.tsv
# 官方稳定三段 tag 是版本前缀，-dbdog.N 是本地打包修订；官方基线变化时 N 从 1 重置。
# release.json 的 current_milestone 不是发布依据。

# PostgreSQL 留空时从构建机 PATH 自动探测 pg_config。
#PG_PREFIX="/home/dbdog/tools/pgsql" # PostgreSQL 安装前缀（bin/lib/share 的父目录）

# ClickHouse 必须显式配置，不能从构建机 PATH 随机选择当前安装版本。
# ClickHouse 必须指向已离线审计的原始 aarch64v80compat 自解压缓存；版本和 SHA 由
# recipe 固定，普通 /usr/local/bin/clickhouse 或 master 更新后的文件会在执行前被拒绝。
#CH_BIN="/home/dbdog/tools/clickhouse/bin/clickhouse"
